{
  "name": "RagIt",
  "version": "1.0.0",
  "description": "Demo RAG para analizar PDFs con citas por página y aislamiento por sesión",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "build": "next build",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration --no-file-parallelism",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker:ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest-worker.ts",
    "cleanup:expired": "node --env-file-if-exists=.env --import tsx scripts/cleanup-expired.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"  
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.5.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
